{
  "task": "pretrain",
  "test_size": 0.05,
  "defaults": {
    "mlm_probability": 0.15,
    "span_mask_probability": 0,
    "num_epochs": 5,
    "batch_size": 8,
    "learning_rate": 0.00015
  },
  "launcher": {
    "type": "torchrun",
    "nproc_per_node": 4
  },
  "models": [
    {
      "name": "popf-base-real",
      "dataset_path": "./data/pt",
      "configuration": "popformer-base",
      "output_path": "./models/popf-base-real"
    },
    {
      "name": "popf-base-discoal",
      "dataset_path": "./data/pt_discoal",
      "configuration": "popformer-base",
      "output_path": "./models/popf-base-discoal"
    },
    {
      "name": "popf-base-real-span",
      "span_mask_probability": 0.15,
      "dataset_path": "./data/pt",
      "configuration": "popformer-base",
      "output_path": "./models/popf-base-real-span"
    },
    {
      "name": "popf-base-discoal-span",
      "span_mask_probability": 0.15,
      "dataset_path": "./data/pt_discoal",
      "configuration": "popformer-base",
      "output_path": "./models/popf-base-discoal-span"
    },
    {
      "name": "popf-base-real-high",
      "mlm_probability": 0.75,
      "dataset_path": "./data/pt",
      "configuration": "popformer-base",
      "output_path": "./models/popf-base-real-high"
    },
    {
      "name": "popf-base-discoal-high",
      "mlm_probability": 0.75,
      "dataset_path": "./data/pt_discoal",
      "configuration": "popformer-base",
      "output_path": "./models/popf-base-discoal-high"
    }
  ]
}
